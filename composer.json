{
	"name": "bindery/bindery",
	"description": "Editable regions for hand-built themes — declarative, locked, multilingual content editing built on WordPress Block Bindings.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"phpstan/phpstan": "^1.11",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Bindery\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Bindery\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"phpstan": "phpstan analyse",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
